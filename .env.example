# ==========================================
# FLOWISE CONFIGURATION
# ==========================================
PORT=3000
APP_URL=http://localhost:3000
DEBUG=false
LOG_LEVEL=info

# Flowise Basic Auth (Opsional: aktifkan untuk melindungi akses UI Flowise)
# FLOWISE_USERNAME=admin
# FLOWISE_PASSWORD=adminpassword

# Kunci Enkripsi Kredensial Flowise (Disarankan diisi string acak aman untuk production)
# FLOWISE_SECRETKEY_OVERWRITE=your-secure-encryption-key-here

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
POSTGRES_DB=flowise
POSTGRES_USER=flowise
POSTGRES_PASSWORD=flowise123
POSTGRES_PORT=5432

# ==========================================
# REDIS QUEUE CONFIGURATION
# ==========================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
MODE=queue
QUEUE_NAME=flowise-queue
WORKER_PORT=5566

# ==========================================
# STORAGE & PATHS
# ==========================================
DATABASE_PATH=/home/node/.flowise
SECRETKEY_PATH=/home/node/.flowise
LOG_PATH=/home/node/.flowise/logs
BLOB_STORAGE_PATH=/home/node/.flowise/storage

# ==========================================
# CORS & NETWORK
# ==========================================
CORS_ORIGINS=*

# ==========================================
# JUBIR AUTH, RBAC & SUBSCRIPTION
# ==========================================
# Generate secure secrets using: openssl rand -hex 32
# JUBIR_JWT_SECRET=
# JUBIR_JWT_ACCESS_SECRET=
# JUBIR_JWT_REFRESH_SECRET=
# JUBIR_JWT_ACCESS_TTL_SECONDS=3600
# JUBIR_JWT_REFRESH_TTL_SECONDS=604800
# JUBIR_SUBSCRIPTION_SUCCESS_URL=http://localhost:3000/subscription?status=success
# JUBIR_SUBSCRIPTION_CANCEL_URL=http://localhost:3000/subscription?status=cancel
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
